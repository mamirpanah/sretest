apiVersion: k0s.k0sproject.io/v1beta1
kind: ClusterConfig
metadata:
  name: k0s-cluster
spec:
  api:
    address: "{{ private_ip }}"
    externalAddress: "{{ private_ip }}"
    sans:
      - "{{ private_ip }}"
{% if use_public_api_sans %}
      - "{{ ansible_host }}"
{% endif %}

  storage:
    type: etcd
    etcd:
      peerAddress: "{{ private_ip }}"

  network:
    podCIDR: 10.244.0.0/16
    serviceCIDR: 10.96.0.0/12
    provider: kuberouter
    calico: null
    kuberouter:
      mtu: 0
      peerRouterIPs: ""
      peerRouterASNs: ""
      autoMTU: true

  telemetry:
    enabled: true

  installConfig:
    users:
      etcdUser: etcd
      kineUser: kube-apiserver
      konnectivityUser: konnectivity-server
      kubeAPIserverUser: kube-apiserver
      kubeSchedulerUser: kube-scheduler

  extensions:
    helm:
      repositories:
      - name: openebs-internal
        url: https://openebs.github.io/openebs
      charts:
      - name: openebs
        chartname: openebs-internal/openebs
        version: "4.2.0"
        namespace: openebs
        order: 1
        values: |
          zfs-localpv:
            crds:
              zfsLocalPv:
                enabled: false
          lvm-localpv:
            crds:
              lvmLocalPv:
                enabled: false
          engines:
            local:
              lvm:
                enabled: false
              zfs:
                enabled: false
            replicated:
              mayastor:
                enabled: false